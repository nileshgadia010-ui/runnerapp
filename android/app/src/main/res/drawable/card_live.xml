<?xml version="1.0" encoding="utf-8"?>
<!-- The running job card: crimson edge so the eye lands on it first. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#14C8102E">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/crimson" />
        </shape>
    </item>
</ripple>
