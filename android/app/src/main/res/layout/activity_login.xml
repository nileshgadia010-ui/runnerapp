<?xml version="1.0" encoding="utf-8"?>
<!-- Sign in. Dark, calm, and built for one thumb: the fields and the button sit in the
     lower half of the screen where the thumb actually reaches on a 6.5 inch phone. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="24dp"
        android:paddingRight="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <!-- brand -->
        <LinearLayout
            android:id="@+id/brandRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_red" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_title"
                    android:textColor="@color/paper"
                    android:textSize="20sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/brand_sub"
                    android:textColor="#93A3BC"
                    android:textSize="12sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Language picker, right where a runner looks first. Shows the current language
                 in its own script, so it is recognisable without reading English. -->
            <TextView
                android:id="@+id/langBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_ghost_light"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="EN"
                android:textColor="@color/paper"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/loginHead"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:text="@string/sign_in"
            android:textColor="@color/paper"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/loginSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/sign_in_sub"
            android:textColor="#93A3BC"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="@string/user_id"
            android:textColor="#7C8CA8"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/field_dark"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:hint="runner1"
            android:textColorHint="#5D6B85"
            android:textColor="@color/paper"
            android:textSize="17sp"
            android:inputType="text"
            android:imeOptions="actionNext"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="@string/password"
            android:textColor="#7C8CA8"
            android:textSize="11sp"
            android:letterSpacing="0.1"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:background="@drawable/field_dark">

            <EditText
                android:id="@+id/password"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:background="@null"
                android:paddingLeft="16dp"
                android:hint="••••••"
                android:textColorHint="#5D6B85"
                android:textColor="@color/paper"
                android:textSize="17sp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:singleLine="true" />

            <TextView
                android:id="@+id/showPass"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="16dp"
                android:text="@string/show"
                android:textColor="#93A3BC"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/loginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:padding="12dp"
            android:background="@drawable/chip_red"
            android:textColor="#FFD9DE"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/loginBtn"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_red"
            android:text="@string/sign_in_btn"
            android:textColor="@color/paper"
            android:textSize="16sp"
            android:letterSpacing="0.06"
            android:textStyle="bold"
            android:stateListAnimator="@null" />

        <ProgressBar
            android:id="@+id/loginSpin"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:visibility="invisible" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Hidden unless the office needs to move this phone to another server.
             Long-press the version line below to reveal it. -->
        <LinearLayout
            android:id="@+id/serverRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/server_address"
                android:textColor="#7C8CA8"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/field_dark"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:textColor="@color/paper"
                android:textSize="14sp"
                android:inputType="textUri"
                android:singleLine="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/versionLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/footer_credit"
            android:textColor="#55637C"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
