<?xml version="1.0" encoding="utf-8"?>
<!-- Home. Three things the runner needs, top to bottom:
     1. how long he has been on duty and what he has done today,
     2. the one job he is on right now,
     3. the list of everything else, today first, then the recent days. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mist"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ dark hero ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/hero_dark"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="44dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/hello"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sign_in"
                        android:textColor="@color/paper"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/empLine"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="#93A3BC"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/dutyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/chip_grey"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="@string/duty_off"
                    android:textColor="@color/ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Language, kept next to sign out so both live-account controls sit together. -->
                <TextView
                    android:id="@+id/langBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/btn_ghost_light"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="7dp"
                    android:paddingBottom="7dp"
                    android:text="EN"
                    android:textColor="@color/paper"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/signOutBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:padding="8dp"
                    android:text="⏻"
                    android:textColor="#93A3BC"
                    android:textSize="18sp" />
            </LinearLayout>

            <!-- the big duty clock -->
            <TextView
                android:id="@+id/dutyTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="00:00"
                android:textColor="@color/paper"
                android:textSize="46sp"
                android:fontFamily="monospace"
                android:letterSpacing="-0.02" />

            <TextView
                android:id="@+id/dutyCaption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/today_on_duty"
                android:textColor="#7C8CA8"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />

            <!-- today's numbers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:id="@+id/tileKm"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/stat_tile"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/kmToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0.0"
                        android:textColor="@color/paper"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/km_today"
                        android:textColor="#7C8CA8"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileTrips"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/stat_tile"
                    android:layout_marginStart="10dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tripsToday"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="@color/paper"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/jobs_done"
                        android:textColor="#7C8CA8"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/tileHours"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/stat_tile"
                    android:layout_marginStart="10dp"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/hoursWeek"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0h"
                        android:textColor="@color/paper"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/five_day_hours"
                        android:textColor="#7C8CA8"
                        android:textSize="10sp"
                        android:letterSpacing="0.1" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ body ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- banners -->
            <TextView
                android:id="@+id/offlineBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/banner_offline"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/warnBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/banner_warn"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:textColor="@color/ink"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:visibility="gone" />

            <!-- punch -->
            <Button
                android:id="@+id/punchBtn"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="@drawable/btn_red"
                android:text="@string/punch_in"
                android:textColor="@color/paper"
                android:textSize="17sp"
                android:letterSpacing="0.06"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/breakBtn"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_outline"
                android:text="@string/take_break"
                android:textColor="@color/ink_soft"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:stateListAnimator="@null"
                android:visibility="gone" />

            <!-- live job -->
            <LinearLayout
                android:id="@+id/jobCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_live"
                android:padding="16dp"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/jobStage"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="@string/running_job"
                        android:textColor="@color/crimson"
                        android:textSize="11sp"
                        android:letterSpacing="0.12"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/jobTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="00:00"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        android:fontFamily="monospace"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/jobTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/jobSub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ink_soft"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp" />

                <TextView
                    android:id="@+id/jobDistance"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/chip_blue"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/cobalt"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/openJobBtn"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_dark"
                    android:text="@string/open_job"
                    android:textColor="@color/paper"
                    android:textSize="15sp"
                    android:letterSpacing="0.06"
                    android:textStyle="bold"
                    android:stateListAnimator="@null" />
            </LinearLayout>

            <!-- Jobs waiting behind the live one. He can tap any of them to head there
                 first - he knows the roads better than the desk does. -->
            <LinearLayout
                android:id="@+id/queueCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="14dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/queueHead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/queue_head"
                    android:textColor="@color/muted"
                    android:textSize="11sp"
                    android:letterSpacing="0.12"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/queueList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/freeNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_flat"
                android:padding="20dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:text="@string/punch_to_start" />

            <!-- trip history -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:layout_marginBottom="4dp"
                android:text="@string/your_jobs"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.14"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/tripList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tripEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_flat"
                android:padding="20dp"
                android:gravity="center"
                android:text="@string/no_jobs_yet"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="28dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
