PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ibs_runner
JWT_SECRET=change-this-secret-key
JWT_EXPIRES=30d
BASE_URL=http://localhost:5000

# SLA targets in minutes (used by the TAT engine)
SLA_ACCEPT=3
SLA_REACH_PICKUP=45
SLA_PICKUP_DWELL=10
SLA_REACH_DROP=45
SLA_DROP_DWELL=10
SLA_TRIP_TOTAL=110
SLA_CROSSMATCH=60
SLA_CASE_TOTAL=240

# How often the runner app should ping location / poll for new work (seconds)
PING_INTERVAL=20
POLL_INTERVAL=5

# Optional: where proof photos are stored. Set this on hosts with an ephemeral
# filesystem (Render) and mount a persistent disk there, e.g. /var/data/uploads
# UPLOAD_DIR=/var/data/uploads
